# ─────────────────────────────────────────────────────────────────────────────
# clash-unchained 配置文件
#
# 使用方式：
#   1. 编辑此文件，填入你的住宅代理信息
#   2. 运行 ./clash-unchained -o clash-global-script.js
#   3. 将生成的脚本粘贴到 Clash Verge → 设置 → 扩展 → 全局扩展脚本
#   4. 在「订阅」面板点击「更新所有订阅」触发重新编译
#   5. 所有订阅自动适配，新增订阅也无需额外配置
#
# 也可以用向导交互式生成：./clash-unchained
# ─────────────────────────────────────────────────────────────────────────────

# ── 住宅代理节点 ───────────────────────────────────────────────────────────
# AI 服务看到的出口 IP 就是这个，用于绕过数据中心 IP 封锁。
# 支持 SOCKS5 协议，可从代理供应商后台获取。
nodes:
  - name: "Residential-US"          # 节点名称，显示在 Clash UI 中
    type: socks5                     # 协议类型（目前仅支持 socks5）
    server: "your.residential.ip"    # 住宅代理服务器地址
    port: 443                        # 端口
    username: "your_username"        # 用户名
    password: "your_password"        # 密码
                                    # dialer-proxy 自动检测，无需配置

# ── AI 路由组 ──────────────────────────────────────────────────────────────
# 这个组会显示在 Clash UI 中，让你知道 AI 流量在走哪条链路。
proxy_groups:
  - name: "LLM-Providers"            # 代理组名称
    type: select                     # 类型：select（手动选择）
    proxies:
      - "Residential-US"             # ← 必须和上面 nodes[0].name 保持一致

# ── AI 域名路由 ────────────────────────────────────────────────────────────
ai_domains:
  proxy_group: "LLM-Providers"       # ← 必须和上面 proxy_groups[0].name 保持一致
  use_builtin: true                  # 内置 75+ AI 域名（OpenAI、Claude、Gemini 等）
  # 额外追加自定义域名（可选）
  # custom:
  #   - "my-ai-service.com"

# ── Tailscale 直连（可选） ─────────────────────────────────────────────────
# 如果你用 Tailscale 组网，开启后 *.ts.net 和 100.64.0.0/10 流量走 DIRECT。
# 包含完整的二层防线：bypass 规则 + DNS 配置（direct-nameserver-follow-policy）。
tailscale:
  enable: true                       # false 则跳过 Tailscale 相关配置
